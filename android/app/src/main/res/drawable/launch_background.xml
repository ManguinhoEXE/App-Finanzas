<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark background -->
    <item android:drawable="@color/background" />

    <!-- Outer glow ring - subtle aura effect -->
    <item
        android:width="100dp"
        android:height="100dp"
        android:gravity="center">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="50dp"
                android:startColor="#20D4AF37"
                android:endColor="#00000000"
                android:centerX="0.5"
                android:centerY="0.5" />
        </shape>
    </item>

    <!-- Gold ring -->
    <item
        android:width="80dp"
        android:height="80dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#10D4AF37" />
            <stroke
                android:width="1.5dp"
                android:color="#50D4AF37" />
        </shape>
    </item>

    <!-- Main gold circle -->
    <item
        android:width="64dp"
        android:height="64dp"
        android:gravity="center">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="32dp"
                android:startColor="#FFD4AF37"
                android:endColor="#FFB8860B"
                android:centerX="0.5"
                android:centerY="0.4" />
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
        </shape>
    </item>

    <!-- Center dot - inner glow -->
    <item
        android:width="20dp"
        android:height="20dp"
        android:gravity="center">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="10dp"
                android:startColor="#40FFFFFF"
                android:endColor="#00FFFFFF"
                android:centerX="0.5"
                android:centerY="0.5" />
        </shape>
    </item>

    <!-- Bottom accent line -->
    <item
        android:width="140dp"
        android:height="1dp"
        android:gravity="center_horizontal|bottom"
        android:bottom="160dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:startColor="#00D4AF37"
                android:centerColor="#40D4AF37"
                android:endColor="#00D4AF37"
                android:angle="0" />
        </shape>
    </item>

    <!-- Top accent line -->
    <item
        android:width="140dp"
        android:height="1dp"
        android:gravity="center_horizontal|top"
        android:top="160dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:startColor="#00D4AF37"
                android:centerColor="#40D4AF37"
                android:endColor="#00D4AF37"
                android:angle="0" />
        </shape>
    </item>
</layer-list>
